# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Environment variables (never commit secrets) ──────────
.env
.env.local
.env.*.local

# ── Uploaded user files ───────────────────────────────────
public/uploads/

# ── Logs ──────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS generated files ────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporary files ───────────────────────────────────────
*.tmp
*.temp
*.cache
.cache/

# ── Build output ──────────────────────────────────────────
dist/
build/
out/

# ── Editor / IDE ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Package lock (keep package-lock.json, ignore yarn) ────
yarn.lock
